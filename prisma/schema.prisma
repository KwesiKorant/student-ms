datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
}

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  students    Student[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
}

model Student {
  id           String           @id @default(cuid())
  studentId    String           @unique
  firstName    String
  lastName     String
  email        String           @unique
  dateOfBirth  String?
  phone        String?
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academicYear Int              @default(1)
  gpa          Float?
  status       EnrollmentStatus @default(ACTIVE)
  
  // Soft Deletion Attributes
  isArchived   Boolean          @default(false)
  archivedAt   DateTime?

  // Audit Relations
  auditLogs    AuditLog[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([isArchived])
  @@index([firstName, lastName])
}

model AuditLog {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  action      String
  details     String
  performedBy String   @default("system_admin")
  timestamp   DateTime @default(now())

  @@index([studentId])
  @@index([timestamp])
}
